# ---- runtime / regenerable (never committed) ----
data/*
!data/DELETED-MEDIA-LOG.txt
tools/
media/
edit-workspace/
node_modules/
__pycache__/
**/__pycache__/
*.pyc

# ---- extension clones: keep only the per-folder repo record ----
# Each folder carries a _REPO.md with its git URL + branch; the contents come back
# from `python scripts\clone_all.py`, not from git. Ignoring the folder itself is
# deliberate: git would otherwise store each clone as an embedded repo / empty
# submodule link (nested .git), and `eclipsia` clones with SHA-256 object format
# which git refuses to index ("cannot add a submodule of a different hash algorithm").
# Records therefore live in two committed places: extensions\REPOS.md (the index) and
# config\repos.json (the source of truth). The per-folder _REPO.md copies on disk are
# regenerated by scripts\write_repo_records.ps1 and are intentionally not tracked.
extensions/*

# ---- secrets ----
config/subtitle_keys.json

# ---- OS noise ----
Thumbs.db
desktop.ini
.DS_Store
